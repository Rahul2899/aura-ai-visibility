# Copy this to .env and fill in your real values
# NEVER commit .env — it is gitignored
#
# Cloud-agnostic: the app needs only Postgres + an OpenRouter key. No AWS, no GCP
# service account, no provider SDK — it runs anywhere Docker runs.

# Tavily Search (optional — enriches probe generation with live web context)
# Free tier: 1000 searches/month. Get key at https://tavily.com
# TAVILY_API_KEY=tvly-your-key-here

# OpenRouter — REQUIRED. Every probe and analysis call goes through it.
# Get a key at https://openrouter.ai/keys. The app refuses to boot without it.
# The model panel is configured in src/llm/client.py (DEFAULT_MODELS) and uses
# `:free` models — no card required. Free tier is ~50 requests/day; adding any
# credit to the account raises it to ~1000/day.
OPENROUTER_API_KEY=sk-or-your-key-here

# PostgreSQL credentials — change POSTGRES_PASSWORD in production
POSTGRES_USER=peec
POSTGRES_PASSWORD=change-this-strong-password
POSTGRES_DB=peec

# Postgres (matches docker-compose.yml)
DATABASE_URL=postgresql+asyncpg://peec:peec@localhost:5432/peec

# Admin key — REQUIRED for API admin access. Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_KEY=your-strong-random-secret-here

# Auto-run audits for example brands on first boot so a fresh deploy isn't empty.
# Runs in the background (non-blocking) and only if OPENROUTER_API_KEY is present.
# On the free tier this consumes most of a day's request quota — set "false" unless
# you actually want the seeded demo data.
AUTO_SEED_AUDITS=false

# Interactive API docs (Swagger /docs, ReDoc /redoc). OFF by default — leaking the
# full API schema publicly aids attacker reconnaissance. Set true for local dev only.
ENABLE_DOCS=false

# Platform-wide safety cap on TOTAL audits per UTC day (protects the request quota).
# Counts every non-admin audit; resets at UTC midnight. Can't be bypassed by incognito
# or switching browsers.
# SIZING: one audit is roughly 50 model calls (~10 probes x 4 models + orchestration).
# OpenRouter free tier is ~50 requests/day, so 1 is the honest cap. Adding any credit
# to the account raises the tier to ~1000/day, which supports ~20.
GLOBAL_DAILY_AUDIT_CAP=1

# Comma-separated list of allowed frontend origins (for CORS)
# On EC2: set to http://YOUR_ELASTIC_IP or https://yourdomain.com
ALLOWED_ORIGINS=http://localhost:3000

# Frontend API base URL (use /api behind Caddy in production; http://localhost:8000 for local dev)
NEXT_PUBLIC_API_URL=http://localhost:8000
